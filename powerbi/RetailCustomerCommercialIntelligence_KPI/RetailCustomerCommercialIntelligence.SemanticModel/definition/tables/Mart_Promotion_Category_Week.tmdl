	annotation PBI_ResultType = Table

	measure 'Promo Product-Store-Weeks' = SUM ( Mart_Promotion_Category_Week[product_store_weeks] )
		formatString: #,##0
		lineageTag: d3089402-d915-4c4f-84e7-019c9857ba87

	measure 'Promo Panel Sales' = SUM ( Mart_Promotion_Category_Week[panel_sales] )
		formatString: $#,##0.00
		lineageTag: fe5d825b-8501-46a3-a893-697f887d8700

	measure 'Promo Sales per PSW' = AVERAGEX ( Mart_Promotion_Category_Week, DIVIDE ( Mart_Promotion_Category_Week[panel_sales], Mart_Promotion_Category_Week[product_store_weeks] ) )
		formatString: $#,##0.0000
		lineageTag: ef8cd559-4c33-4bdd-928d-5d36072babb2
