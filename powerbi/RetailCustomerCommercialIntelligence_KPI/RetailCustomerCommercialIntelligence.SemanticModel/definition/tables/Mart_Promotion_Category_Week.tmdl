	partition Mart_Promotion_Category_Week = m
		mode: import
		source =
			let
				Source = Parquet.Document(Binary.Buffer(File.Contents("D:\data\Codex\_retail_da_stage_20260922\run\05_powerbi_exports\Mart_Promotion_Category_Week.parquet")))
