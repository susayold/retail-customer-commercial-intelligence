	measure 'First 13W Panel Spend Display' = VAR v = [First 13W Panel Spend] RETURN IF ( ISBLANK ( v ), "No data", SWITCH ( TRUE (), ABS ( v ) >= 1000000, "$" & FORMAT ( v / 1000000, "0.00" ) & "M", ABS ( v ) >= 1000, "$" & FORMAT ( v / 1000, "0.0" ) & "K", "$" & FORMAT ( v, "0" ) ) )
		formatString: General
		lineageTag: 9c2a1b7e-4d5f-4c61-8b90-8f4a8d1f1c10

