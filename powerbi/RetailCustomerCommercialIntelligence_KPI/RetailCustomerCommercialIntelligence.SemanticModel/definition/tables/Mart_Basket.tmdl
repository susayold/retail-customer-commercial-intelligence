	measure 'Spend per Basket Change %' = DIVIDE ( [Last 13W Spend per Basket] - [First 13W Spend per Basket], [First 13W Spend per Basket] )
		formatString: 0.0%
		lineageTag: a794e5da-6671-430e-8662-cdc2c55b1925

	measure 'First 13W Trips per HH' = VAR w = MINX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Trips per Active Household], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w && Dim_Week[week_number] <= w + 12 ) )
		formatString: 0.00
		lineageTag: 99cfba07-a273-4689-aff1-ab7db1312ba9

	measure 'Last 13W Trips per HH' = VAR w = MAXX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Trips per Active Household], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w - 12 && Dim_Week[week_number] <= w ) )
