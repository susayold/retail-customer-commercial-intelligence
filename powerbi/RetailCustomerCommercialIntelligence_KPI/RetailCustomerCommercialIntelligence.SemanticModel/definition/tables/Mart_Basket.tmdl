		lineageTag: a1259e36-32a8-42b4-93c3-1eb57eac2dc0

	measure 'Panel Spend Delta Label' = VAR d = [Panel Spend Change %] RETURN IF ( ISBLANK ( d ), UNICHAR ( 8226 ) & " No prior-period comparison", IF ( d >= 0, UNICHAR ( 9650 ) & " +" & FORMAT ( d, "0.0%" ) & " vs 13W", UNICHAR ( 9660 ) & " " & FORMAT ( d, "0.0%" ) & " vs 13W" ) )
		formatString: General
		lineageTag: 4a891788-f451-4280-86e7-f1f5c77522e3

	measure 'Trips per HH Delta Label' = VAR d = [Trips per HH Change %] RETURN IF ( ISBLANK ( d ), UNICHAR ( 8226 ) & " No prior-period comparison", IF ( d >= 0, UNICHAR ( 9650 ) & " +" & FORMAT ( d, "0.0%" ) & " vs 13W", UNICHAR ( 9660 ) & " " & FORMAT ( d, "0.0%" ) & " vs 13W" ) )
		formatString: General
		lineageTag: 4af29ffa-766a-41bf-8aa3-9ff8e3210e60

	measure 'Spend per Basket Delta Label' = VAR d = [Spend per Basket Change %] RETURN IF ( ISBLANK ( d ), UNICHAR ( 8226 ) & " No prior-period comparison", IF ( d >= 0, UNICHAR ( 9650 ) & " +" & FORMAT ( d, "0.0%" ) & " vs 13W", UNICHAR ( 9660 ) & " " & FORMAT ( d, "0.0%" ) & " vs 13W" ) )
