	measure 'Last 13W Active HH Display' = VAR v = [Last 13W Active Households] RETURN IF ( ISBLANK ( v ), "No data", IF ( ABS ( v ) >= 1000, FORMAT ( v / 1000, "0.0" ) & "K", FORMAT ( v, "0" ) ) )
