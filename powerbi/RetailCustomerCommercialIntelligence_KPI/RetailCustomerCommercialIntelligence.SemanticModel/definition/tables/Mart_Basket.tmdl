		formatString: General
		lineageTag: 243a03c6-bc29-4115-8ccb-b40ecac66905

	measure 'KPI No Prior Period Delta' = UNICHAR ( 8226 ) & " No prior-period comparison"
		formatString: General
		lineageTag: e78f5fea-a58d-4dd1-aee1-7aba79bc289a

	measure 'Spend per Active Household' = DIVIDE ( [Panel Net Spend], [Active Panel Households] )
		formatString: $#,##0.00
		lineageTag: 6e9d77af-5f78-4f3b-a12e-2b3f7d4e91c0

	measure 'Coupon Basket Rate' = DIVIDE ( CALCULATE ( [Baskets], Mart_Basket[has_coupon_discount] = TRUE () ), [Baskets] )
		formatString: 0.0%
		lineageTag: 2bf9f3b8-91c4-47cf-8fb2-7e6d3d93a2d1

	measure 'Baskets Delta Label' = VAR d = [Baskets Change %] RETURN IF ( ISBLANK ( d ), UNICHAR ( 8226 ) & " No prior-period comparison", IF ( d >= 0, UNICHAR ( 9650 ) & " +" & FORMAT ( d, "0.0%" ) & " vs 13W", UNICHAR ( 9660 ) & " " & FORMAT ( d, "0.0%" ) & " vs 13W" ) )
		formatString: General
