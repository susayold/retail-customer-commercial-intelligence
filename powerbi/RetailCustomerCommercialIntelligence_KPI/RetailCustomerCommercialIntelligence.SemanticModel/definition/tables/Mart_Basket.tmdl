	annotation PBI_ResultType = Table

	measure 'Panel Net Spend' = SUM ( Mart_Basket[basket_net_spend] )
		formatString: $#,##0.00
		lineageTag: 3e6154a3-aaf6-4eeb-92d9-acdcce3b4860

	measure 'Baskets' = DISTINCTCOUNT ( Mart_Basket[basket_id] )
		formatString: #,##0
		lineageTag: 7e59f47a-1896-4aa4-aff7-2e08514c9021

	measure 'Active Panel Households' = DISTINCTCOUNT ( Mart_Basket[household_key] )
		formatString: #,##0
		lineageTag: fdc57bd6-c40d-4b80-92ee-404de37b2cb2

	measure 'Spend per Basket' = DIVIDE ( [Panel Net Spend], [Baskets] )
		formatString: $#,##0.00
		lineageTag: 26cc342c-b811-401c-949b-1e1b21858e71

	measure 'Trips per Active Household' = DIVIDE ( [Baskets], [Active Panel Households] )
		formatString: 0.00
		lineageTag: 9ed7ec83-b785-41bf-92df-503c7278a36c

	measure 'First 13W Panel Spend' = VAR w = MINX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Panel Net Spend], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w && Dim_Week[week_number] <= w + 12 ) )
		formatString: $#,##0.00
		lineageTag: 957200b4-3264-4ba7-881f-c4394f3e9a4d

	measure 'Last 13W Panel Spend' = VAR w = MAXX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Panel Net Spend], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w - 12 && Dim_Week[week_number] <= w ) )
		formatString: $#,##0.00
		lineageTag: c1d4c847-62c5-43e2-84ff-9eac1f487ba1

	measure 'Panel Spend Change %' = DIVIDE ( [Last 13W Panel Spend] - [First 13W Panel Spend], [First 13W Panel Spend] )
		formatString: 0.0%
		lineageTag: 1862f866-fde6-47d8-8183-f2a8f9b8fc6f

	measure 'First 13W Active Households' = VAR w = MINX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Active Panel Households], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w && Dim_Week[week_number] <= w + 12 ) )
		formatString: #,##0
		lineageTag: 9cbccd3e-69b5-4541-8464-e90283e97767

	measure 'Last 13W Active Households' = VAR w = MAXX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Active Panel Households], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w - 12 && Dim_Week[week_number] <= w ) )
		formatString: #,##0
		lineageTag: b291b1dd-6722-4f57-a4a7-e23607ce64a2

	measure 'Active Households Change %' = DIVIDE ( [Last 13W Active Households] - [First 13W Active Households], [First 13W Active Households] )
		formatString: 0.0%
		lineageTag: 24679d2d-ddee-431e-bd37-ed4b40fe0211

	measure 'First 13W Baskets' = VAR w = MINX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Baskets], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w && Dim_Week[week_number] <= w + 12 ) )
		formatString: #,##0
		lineageTag: b47df48f-23ec-456d-a54e-ac3cfbf65256

	measure 'Last 13W Baskets' = VAR w = MAXX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Baskets], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w - 12 && Dim_Week[week_number] <= w ) )
		formatString: #,##0
		lineageTag: f9af333a-c680-410f-a4f9-6fca4a2cd862

	measure 'Baskets Change %' = DIVIDE ( [Last 13W Baskets] - [First 13W Baskets], [First 13W Baskets] )
		formatString: 0.0%
		lineageTag: d8c88347-35e9-4de0-81a3-fb01f079f930

	measure 'First 13W Spend per Basket' = VAR w = MINX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Spend per Basket], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w && Dim_Week[week_number] <= w + 12 ) )
		formatString: $#,##0.00
		lineageTag: aa7a29c2-446e-48f2-9f7b-3a970ed15daf

	measure 'Last 13W Spend per Basket' = VAR w = MAXX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Spend per Basket], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w - 12 && Dim_Week[week_number] <= w ) )
