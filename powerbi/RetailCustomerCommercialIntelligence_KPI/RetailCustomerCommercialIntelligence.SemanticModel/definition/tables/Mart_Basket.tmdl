	measure 'Trips per HH Change %' = DIVIDE ( [Last 13W Trips per HH] - [First 13W Trips per HH], [First 13W Trips per HH] )
		formatString: 0.0%
		lineageTag: bed2ed89-246a-4148-b0b7-357432878bee

	measure 'Segment Households' = DISTINCTCOUNT ( Mart_Basket[household_key] )
		formatString: #,##0
		lineageTag: 5ec7bdee-b615-4215-a660-9f41d3aed835

	measure 'Segment Spend' = [Panel Net Spend]
		formatString: $#,##0.00
		lineageTag: e2297dc2-3e45-4ae0-83f2-4643933596d4

	measure 'Segment Spend Share' = DIVIDE ( [Segment Spend], CALCULATE ( [Panel Net Spend], ALL ( Mart_Basket[segment] ) ) )
		formatString: 0.0%
		lineageTag: c0db3d6f-9526-499b-8a4d-14d6bfa08241

	measure 'Segment Avg Basket' = [Spend per Basket]
