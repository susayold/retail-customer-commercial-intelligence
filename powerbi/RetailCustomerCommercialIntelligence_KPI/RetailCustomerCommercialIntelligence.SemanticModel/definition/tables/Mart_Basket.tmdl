	measure 'Spend per Active HH Change %' = DIVIDE ( [Last 13W Panel Spend] / [Last 13W Active Households] - [First 13W Panel Spend] / [First 13W Active Households], [First 13W Panel Spend] / [First 13W Active Households] )
		formatString: 0.0%
		lineageTag: 4a56e71a-9d4c-45d7-bf3b-2d7c8e91aa62

	measure 'Spend per Active HH Delta Label' = VAR d = [Spend per Active HH Change %] RETURN IF ( ISBLANK ( d ), UNICHAR ( 8226 ) & " No prior-period comparison", IF ( d >= 0, UNICHAR ( 9650 ) & " +" & FORMAT ( d, "0.0%" ) & " vs 13W", UNICHAR ( 9660 ) & " " & FORMAT ( d, "0.0%" ) & " vs 13W" ) )
