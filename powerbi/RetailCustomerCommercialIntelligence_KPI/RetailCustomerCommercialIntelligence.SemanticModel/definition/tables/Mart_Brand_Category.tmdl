	column discount_rate
		dataType: double
		summarizeBy: none
		sourceColumn: discount_rate

	partition Mart_Brand_Category = m
		mode: import
		source =
			let
				Source = Parquet.Document(Binary.Buffer(File.Contents("D:\data\Codex\_retail_da_stage_20260922\run\05_powerbi_exports\Mart_Brand_Category.parquet")))
			in
