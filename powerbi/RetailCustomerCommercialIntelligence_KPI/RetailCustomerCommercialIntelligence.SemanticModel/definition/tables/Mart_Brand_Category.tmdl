	annotation PBI_ResultType = Table

	measure 'Private Label Spend' = CALCULATE ( SUM ( Mart_Brand_Category[panel_net_spend] ), Mart_Brand_Category[brand_type] = "PRIVATE" )
		formatString: $#,##0.00
		lineageTag: 4716f6fd-a369-4321-9643-dec5109b676b

	measure 'Private Label Share' = DIVIDE ( [Private Label Spend], SUM ( Mart_Brand_Category[panel_net_spend] ) )
		formatString: 0.0%
		lineageTag: ae0eacee-7185-450c-907b-2768fa79635f

	measure 'Private Label Category Spend' = [Private Label Spend]
		formatString: $#,##0.00
		lineageTag: 80c5c676-595a-4629-97c9-fffc92298918
