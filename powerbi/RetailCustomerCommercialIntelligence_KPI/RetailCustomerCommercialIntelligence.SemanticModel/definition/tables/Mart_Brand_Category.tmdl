		summarizeBy: none
		sourceColumn: department

	column commodity
		dataType: string
		summarizeBy: none
		sourceColumn: commodity

	column brand_type
		dataType: string
		summarizeBy: none
		sourceColumn: brand_type

	column panel_net_spend
