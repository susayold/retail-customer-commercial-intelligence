table Mart_Category_Weekly
	lineageTag: deffa73b-6ad4-47d3-9da4-cc336de3e6ce

	column week_number
		dataType: int64
		summarizeBy: none
		sourceColumn: week_number

	column department
		dataType: string
		summarizeBy: none
		sourceColumn: department

	column commodity
		dataType: string
		summarizeBy: none
		sourceColumn: commodity

	column panel_net_spend
		dataType: double
		summarizeBy: none
		sourceColumn: panel_net_spend

	column buying_households
		dataType: int64
		summarizeBy: none
		sourceColumn: buying_households

	column active_panel_households
		dataType: int64
		summarizeBy: none
		sourceColumn: active_panel_households

	column category_penetration
		dataType: double
		summarizeBy: none
		sourceColumn: category_penetration

	column category_baskets
		dataType: int64
		summarizeBy: none
		sourceColumn: category_baskets

	column spend_per_buying_household
		dataType: double
		summarizeBy: none
		sourceColumn: spend_per_buying_household

	column discount_rate
		dataType: double
		summarizeBy: none
		sourceColumn: discount_rate

	column private_label_share
		dataType: double
		summarizeBy: none
		sourceColumn: private_label_share

	partition Mart_Category_Weekly = m
		mode: import
		source =
			let
				Source = Parquet.Document(Binary.Buffer(File.Contents("D:\data\Codex\_retail_da_stage_20260922\run\05_powerbi_exports\Mart_Category_Weekly.parquet")))
			in
				Source

	annotation PBI_ResultType = Table

	measure 'Category Spend' = SUM ( Mart_Category_Weekly[panel_net_spend] )
		formatString: $#,##0.00
		lineageTag: 9381c514-5079-41c0-a03e-a62c3a7a4f7e

	measure 'Category Baskets' = SUM ( Mart_Category_Weekly[category_baskets] )
		formatString: #,##0
		lineageTag: 128c570d-281d-4c05-baec-7f47a27291b8

	measure 'Category Buyers' = SUM ( Mart_Category_Weekly[buying_households] )
		formatString: #,##0
		lineageTag: b4031cb2-7f6d-4540-a9af-51255a628f7c

	measure 'Category Penetration' = DIVIDE ( SUM ( Mart_Category_Weekly[buying_households] ), SUM ( Mart_Category_Weekly[active_panel_households] ) )
		formatString: 0.0%
		lineageTag: 4f6b8c21-1a5d-4b90-9e37-2c7d6a8b5f11

	measure 'Spend per Category Basket' = DIVIDE ( [Category Spend], [Category Baskets] )
		formatString: $#,##0.00
		lineageTag: 7e2a9c41-5b6d-4f80-a3e9-1c8d7b2a6f55

	measure 'First 13W Category Spend' = VAR w = MINX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Category Spend], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w && Dim_Week[week_number] <= w + 12 ) )
		formatString: $#,##0.00
		lineageTag: 5b8d2a71-3c6f-4e90-b1a7-9d2c8f6e4b33

	measure 'Last 13W Category Spend' = VAR w = MAXX ( ALL ( Dim_Week ), Dim_Week[week_number] ) RETURN CALCULATE ( [Category Spend], FILTER ( ALL ( Dim_Week ), Dim_Week[week_number] >= w - 12 && Dim_Week[week_number] <= w ) )
		formatString: $#,##0.00
		lineageTag: 9c4e7a21-6b8d-4f30-a5e1-2d7c9b6f8a44

	measure 'Category Spend Change %' = DIVIDE ( [Last 13W Category Spend] - [First 13W Category Spend], [First 13W Category Spend] )
		formatString: 0.0%
		lineageTag: 2a7d9c51-4e6f-4b80-8c3a-1d5e7f9b2c66

	measure 'Category Penetration Delta Label' = VAR d = [Category Penetration] RETURN IF ( ISBLANK ( d ), UNICHAR ( 8226 ) & " No prior-period comparison", UNICHAR ( 8226 ) & " " & FORMAT ( d, "0.0%" ) & " observed penetration" )
		formatString: General
		lineageTag: 6e1a8c42-5d7f-4b90-a3c9-2d8e7f1b6a55

	measure 'Category Spend Delta Label' = VAR d = [Category Spend Change %] RETURN IF ( ISBLANK ( d ), UNICHAR ( 8226 ) & " No prior-period comparison", IF ( d >= 0, UNICHAR ( 9650 ) & " +" & FORMAT ( d, "0.0%" ) & " vs 13W", UNICHAR ( 9660 ) & " " & FORMAT ( d, "0.0%" ) & " vs 13W" ) )
		formatString: General
		lineageTag: 8b2c6d41-7e9f-4a50-b3c1-5d8e2f7a9b66
