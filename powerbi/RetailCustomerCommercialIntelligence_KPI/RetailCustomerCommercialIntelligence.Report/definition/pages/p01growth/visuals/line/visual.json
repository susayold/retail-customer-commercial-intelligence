{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.9.0/schema.json",
  "name": "line",
  "position": {
    "x": 250,
    "y": 310,
    "z": 10,
    "width": 700,
    "height": 260,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "lineClusteredColumnComboChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Week"
                    }
                  },
                  "Property": "month_label"
                }
              },
              "queryRef": "Dim_Week.month_label",
              "nativeQueryRef": "month_label",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Mart_Basket"
                    }
                  },
                  "Property": "Panel Net Spend"
                }
              },
              "queryRef": "Mart_Basket.Panel Net Spend",
              "nativeQueryRef": "Panel Net Spend",
              "active": true
            }
          ]
        },
        "Y2": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "Mart_Basket" } },
                  "Property": "Baskets"
                }
              },
              "queryRef": "Mart_Basket.Baskets",
              "nativeQueryRef": "Baskets",
              "active": true
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [{
        "properties": { "fill": { "solid": { "color": { "expr": { "Literal": { "Value": "'#00695C'" } } } } }, "defaultColor": { "solid": { "color": { "expr": { "Literal": { "Value": "'#00695C'" } } } } } },
        "selector": { "id": "default" }
      }]
    },
    "visualContainerObjects": {
      "title": [{ "properties": { "show": { "expr": { "Literal": { "Value": "true" } } }, "text": { "expr": { "Literal": { "Value": "'Sales Trend'" } } }, "fontColor": { "solid": { "color": { "expr": { "Literal": { "Value": "'#12396E'" } } } } }, "fontSize": { "expr": { "Literal": { "Value": "'16'" } } } } }],
      "background": [{ "properties": { "show": { "expr": { "Literal": { "Value": "true" } } }, "color": { "solid": { "color": { "expr": { "Literal": { "Value": "'#FFFFFF'" } } } } }, "transparency": { "expr": { "Literal": { "Value": "0D" } } } } }],
      "border": [{ "properties": { "show": { "expr": { "Literal": { "Value": "false" } } }, "radius": { "expr": { "Literal": { "Value": "8D" } } } } }],
      "dropShadow": [{ "properties": { "show": { "expr": { "Literal": { "Value": "true" } } }, "preset": { "expr": { "Literal": { "Value": "'Bottom'" } } }, "position": { "expr": { "Literal": { "Value": "'Outer'" } } }, "color": { "solid": { "color": { "expr": { "Literal": { "Value": "'#718096'" } } } } }, "transparency": { "expr": { "Literal": { "Value": "85D" } } }, "shadowBlur": { "expr": { "Literal": { "Value": "8D" } } }, "shadowDistance": { "expr": { "Literal": { "Value": "2D" } } } } }],
      "visualHeader": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  }
